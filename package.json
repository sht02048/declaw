{
  "name": "declaw",
  "version": "0.1.0",
  "description": "See which Claude Code plugins, skills, and MCP servers you actually use, and remove the rest.",
  "keywords": [
    "claude-code",
    "claude",
    "plugins",
    "skills",
    "mcp",
    "cli",
    "cleanup"
  ],
  "license": "MIT",
  "author": "Minsug Chae",
  "homepage": "https://declaw.minsug.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sht02048/declaw.git"
  },
  "bugs": {
    "url": "https://github.com/sht02048/declaw/issues"
  },
  "type": "module",
  "bin": {
    "declaw": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "start": "npm run build --silent && node dist/cli.js",
    "stats": "npm start --silent -- stats",
    "dry-run": "npm start --silent -- --dry-run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "trash": "^10.1.1"
  }
}
